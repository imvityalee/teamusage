# Copy to .env (git-ignored) and fill in. Never commit .env.
# Runs the public multi-team service instead of a single self-hosted team.
TEAMUSAGE_MODE=hosted
# Port to listen on.
PORT=8787
# Address to listen on.
TEAMUSAGE_HOST=127.0.0.1
# Where the database is kept.
TEAMUSAGE_DATA_DIR=
# The server's own origin: https, or http for localhost only.
TEAMUSAGE_PUBLIC_URL=http://localhost:8787
# Client id of the GitHub OAuth app used for sign-in.
TEAMUSAGE_GITHUB_CLIENT_ID=
# Client secret of the GitHub OAuth app.
TEAMUSAGE_GITHUB_CLIENT_SECRET=
# Seals team codes: 32 random bytes in base64 (openssl rand -base64 32).
TEAMUSAGE_CODE_KEY=
