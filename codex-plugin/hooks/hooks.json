{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "TEAMUSAGE_HOOK=codex npx -y teamusage@0.3.1 sync --quiet --detach >/dev/null 2>&1 &",
            "statusMessage": "teamusage: send usage"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "F=\"${XDG_CONFIG_HOME:-$HOME/.config}/teamusage/codex-notice.json\"; [ -f \"$F\" ] && cat \"$F\" && rm -f \"$F\"; TEAMUSAGE_HOOK=codex npx -y teamusage@0.3.1 sync --quiet --detach --throttle 4h >/dev/null 2>&1 &",
            "statusMessage": "teamusage: send usage"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "TEAMUSAGE_HOOK=codex npx -y teamusage@0.3.1 sync --quiet --detach >/dev/null 2>&1 &",
            "statusMessage": "teamusage: send usage"
          }
        ]
      }
    ]
  }
}
