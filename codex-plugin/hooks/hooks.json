{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y teamusage@0.3.0 sync --quiet --detach"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y teamusage@0.3.0 sync --quiet --detach --throttle 4h"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y teamusage@0.3.0 sync --quiet --detach"
          }
        ]
      }
    ]
  }
}
