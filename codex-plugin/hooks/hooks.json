{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'TEAMUSAGE_HOOK=codex npx -y teamusage@0.3.1 sync --quiet --detach >/dev/null 2>&1 &'",
            "statusMessage": "teamusage: send usage"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'D=${XDG_CONFIG_HOME:-}; case \"$D\" in /*) ;; *) D=\"$HOME/.config\";; esac; F=\"$D/teamusage/codex-notice.json\"; [ -f \"$F\" ] && cat \"$F\" && rm -f \"$F\"; npx -y teamusage@0.3.1 sync --quiet --detach --throttle 4h >/dev/null 2>&1 &'",
            "statusMessage": "teamusage: send usage"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'TEAMUSAGE_HOOK=codex npx -y teamusage@0.3.1 sync --quiet --detach >/dev/null 2>&1 &'",
            "statusMessage": "teamusage: send usage"
          }
        ]
      }
    ]
  }
}
