{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "npx",
            "args": ["-y", "teamusage@0.2.0", "sync", "--quiet", "--detach"],
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx",
            "args": ["-y", "teamusage@0.2.0", "sync", "--quiet", "--detach"],
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx",
            "args": ["-y", "teamusage@0.2.0", "sync", "--quiet", "--detach", "--throttle", "4h"],
            "async": true
          }
        ]
      }
    ]
  }
}
